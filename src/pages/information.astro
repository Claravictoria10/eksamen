---
import Layout from "../Layout/Layout.astro";
import Forside2 from "../Component/Forside2.astro";
import Oremaerket from "../Component/Oremaerket.astro";
import Hvorfor from "../Component/Hvorfor.astro";
import Usikkerverden from "../Component/Usikkerverden.astro";
import Pcard from "../Component/Pcard.astro";

import { getFordeleData } from "../services/fordeleService";

//Klader fordele Service for at få data//
const data= await getFordeleData();
---

<Layout>
    <Forside2/>
    <Oremaerket/>
    <Hvorfor/>
    <Usikkerverden/>
    <Pcard fordele={data}/>
</Layout>