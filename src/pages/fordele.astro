---
import Detailsfordele from "../Component/Detailsfordele.astro";
import Pcard from "../Component/Pcard.astro";
import Layout from "../Layout/Layout.astro";
import Forside3 from "../Component/Forside3.astro";
import Roskilde from "../Component/Roskilde.astro";

const endpoint ="https://fxpijactmaogkzunxsea.supabase.co/rest/v1/fordele";

//vi laver et opjekt der kan sende flere oplysninger med i fetch//
const options ={
    headers:{
        apikey:"sb_publishable_pGpw0KvnLwhCF1yc4PBsjw_260GHBje", 
    }
}

//gå til det her endpoint og så sæt de her options med, når du fetcher//
const data= await fetch (endpoint, options).then((response) => response.json());

console.log(data)
---


<Layout>
  <Forside3/>
{data.map((fordele: any) => (
    <Detailsfordele fordel={fordele} />
  )
)}
<Roskilde/>
<Pcard />
</Layout>