---
import Pcard from "./Pcard.astro";

const endpoint ="https://fxpijactmaogkzunxsea.supabase.co/rest/v1/fordele";

//vi laver et opjekt der kan sende flere oplysninger med i fetch//
const options ={
    headers:{
        apikey:"sb_publishable_pGpw0KvnLwhCF1yc4PBsjw_260GHBje", 
    }
}

//gå til det her endpoint og så sæt de her options med, når du fetcher//
const data= await fetch (endpoint, options).then((response) => response.json());

console.log(data)

---
<article>
  <h2>Fordelene ved at vælge Dankort Øremærket</h2>
<div class="buttons">
  {data.map((fordel: any) => (
    <Pcard fordel={fordel} />
  ))}
</div>
</article>

<style>
  img {
    border-radius: 30px;
    width: 80%;
    display: block;
    margin: 0 auto; /* Centrer billede horisontalt */
  }

  a{text-align: center;
    color: black;
    text-decoration: none;
  
  }

  .kategori_tekst {
    padding-top: 10px;
    text-align: center;
    color: black;
  }
  .buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
    justify-items: center;
  }

  .card {
    display: flex;
    flex-direction: column; /* Sørger for at elementerne ligger under hinanden i en kolonne */
    align-items: center;
  }

  h2 {text-align: center;}

article {
  background-color: #EDEDED;
  padding: 20px;}

  /* desktop */
  @media (min-width: 900px) {
    .buttons {
      grid-template-columns: repeat(4, 1fr);
        padding-left: 150px;
        padding-right: 150px;
    }

  }
</style>

