---
const { title, variant, href, type = "button" } = Astro.props;
const className = variant ? `btn btn--${variant}` : "btn";
---

{
  href ? (
    <a class={className} href={href}>
      {title}
    </a>
  ) : (
    <button class={className} type={type}>
      {title}
    </button>
  )
}

<style>
  .btn {
    background-color: #ffffff;
    color: #ff2d2d;
    border: none;
    cursor: pointer;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    line-height: 1;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);

    /* vigtigt for <a> */
    text-decoration: none;
  }

  /* gør link-visited ikke bliver lilla */
  .btn:visited {
    color: #ff2d2d;
  }

  /* hover føles som en knap */
  .btn:hover {
    filter: brightness(0.95);
  }
</style>