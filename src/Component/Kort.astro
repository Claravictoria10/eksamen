---
import Button2 from "./Button2.astro";


---

<section class="kort-section">
  <div class="kort-container">
    <div class="kort-card">
      <div class="kort-image">
        <img src="/img/iphone.webp" alt="Image" />
      </div>
      <div class="kort-content">
        <h1>Bestil dit kort</h1>
        <h2>Kom i gang med Dankort Øremærket</h2>
        <p>Vælg et kort, der gør en forskel i hverdagen, og støt et formål, du tror på.</p>
        <Button2 title="→" href="/bestilkort"/>
      </div>
    </div>
  </div>
</section>

<style>
  .kort-section {
    background-color: #ffffff;
    padding: 28px 20px;
  }

  .kort-container {
    background-color: #dcdcdc;
    border-radius: 26px;
    padding: 36px 42px;
    max-width: 1120px;
    margin: 0 auto;
  }

  .kort-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .kort-image {
    flex: 0 0 32%;
    display: flex;
    justify-content: center;
  }

  .kort-image img {
    width: 100%;
    max-width: 220px;
    border-radius: 10px;
  }

  .kort-content {
    flex: 1;
    padding-left: 20px;
  }

  .kort-content h1 {
    font-size: 35px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .kort-content h2 {
    font-size: 25px;
    font-weight: 700;
    margin-bottom: 10px;
  }

  .kort-content p {
    font-size: 20px;
    font-weight: 400;
    margin-bottom: 20px;
  }

  .kort-content button span {
    transform: translateY(-1px);
  }

  @media (min-width: 900px) {
    .kort-card {
      flex-direction: row;
    }
  }

  @media (max-width: 1023px) {
    .kort-container {
      padding: 24px;
      border-radius: 18px;
    }

    .kort-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .kort-image {
      flex: none;
      width: 100%;
      justify-content: flex-start;
    }

    .kort-content {
      padding-left: 0;
    }
  }
  
</style>