---
import Button2 from "./Button2.astro";
const { title, href, ...props } = Astro.props;
---

<section class="kort-section">
  <div class="kort-container">
    <div class="kort-card">
      <div class="kort-image">
        <img src="/img/iphone.webp" alt="Image" />
      </div>
      <div class="kort-content">
        <h2>Gratis og uden ændringer i din daglige brug.</h2>
        <p>Tilmeldingen tager under 2 minutter, er helt gratis og kræver ingen ændringer i din daglige rutine. Det er en nem og hurtig proces, der sikrer, at du kan fortsætte med at bruge tjenesten uden besvær.</p>
        <Button2 id="button" title="→" href="/bestilkort"/>
      </div>
    </div>
  </div>
</section>



<style>
.kort-card {
  background-color: #EDEDED;
  border-radius: 20px;
  padding: 10px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
}

.kort-image {
  display: flex;
  justify-content: center;
  align-items: center;
}

.kort-image img {
  width: 60%;
  height: auto;
  display: block;
}
section{padding: 20px;}

@media (min-width: 900px) {
  .kort-image img {
  width: 35%;
  padding-bottom: 20px;
  padding-top: 20px;
}

section{
  padding-left: 120px;
  padding-right: 120px;}

.kort-content{width: 70%;}






}





</style>





