    position: absolute;
    top: 90px;
    left: 24px;
    max-width: 70%;
  }

    h1 {
        font-family: "Raleway", sans-serif;
  }

  #dankort{color: #E21E27;}

  #tekst {
    position: absolute;
    top: 230px;
    left: 24px;
    right: 24px;
    max-width: 50%;
  }

  #tekst p {
    font-family: "Raleway", sans-serif;
  }

  #kroner {
    position: absolute;
    bottom: 20%;
    left: 8%;
